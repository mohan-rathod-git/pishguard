# ─── PhishGuard AI Configuration ───
APP_NAME=PhishGuard AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Rate Limiting
RATE_LIMIT=100/minute

# Model
MODEL_PATH=app/models/phishguard_model.joblib
SCALER_PATH=app/models/scaler.joblib
MODEL_VERSION=1.0.0

# Dataset
DATASET_PATH=../datasets/new_data_urls.csv
MAX_DATASET_ROWS=500000

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_BATCH_SIZE=100
MAX_URL_LENGTH=2048

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/phishguard.log
